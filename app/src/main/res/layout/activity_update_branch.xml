<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ================================================= -->
        <!-- TITLE -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="Update Branch"
            android:textColor="#1C1B1F"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- ================================================= -->
        <!-- BRANCH CODE -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Branch Code"
            android:textColor="#1C1B1F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E2EC"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/edtBranchCode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:hint="Enter branch code"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1C1B1F"
                android:textColorHint="#79747E"
                android:textSize="15sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- BRANCH NAME -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Branch Name"
            android:textColor="#1C1B1F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E2EC"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/edtBranchName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:hint="Enter branch name"
                android:inputType="textCapWords"
                android:imeOptions="actionNext"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1C1B1F"
                android:textColorHint="#79747E"
                android:textSize="15sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- ADDRESS -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Address"
            android:textColor="#1C1B1F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E2EC"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/edtAddress"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@android:color/transparent"
                android:hint="Enter address"
                android:inputType="textCapSentences|textMultiLine"
                android:gravity="top"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:textColor="#1C1B1F"
                android:textColorHint="#79747E"
                android:textSize="15sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- PHONE -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Phone"
            android:textColor="#1C1B1F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E2EC"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/edtPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:hint="Enter phone number"
                android:inputType="phone"
                android:imeOptions="actionNext"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1C1B1F"
                android:textColorHint="#79747E"
                android:textSize="15sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- EMAIL -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Email"
            android:textColor="#1C1B1F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E2EC"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:hint="Enter email"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1C1B1F"
                android:textColorHint="#79747E"
                android:textSize="15sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- LATITUDE -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Latitude"
            android:textColor="#1C1B1F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E2EC"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/edtLatitude"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:hint="Example: 6.927079"
                android:inputType="numberDecimal|numberSigned"
                android:imeOptions="actionNext"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1C1B1F"
                android:textColorHint="#79747E"
                android:textSize="15sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- LONGITUDE -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Longitude"
            android:textColor="#1C1B1F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E2EC"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/edtLongitude"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:hint="Example: 79.861244"
                android:inputType="numberDecimal|numberSigned"
                android:imeOptions="actionNext"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1C1B1F"
                android:textColorHint="#79747E"
                android:textSize="15sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- STATUS -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Status"
            android:textColor="#1C1B1F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E2EC"
            app:strokeWidth="1dp">

            <Spinner
                android:id="@+id/spinnerStatus"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!-- BUTTONS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#B3261E"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="#B3261E"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateBranch"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#6750A4"
                android:text="Update Branch"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>