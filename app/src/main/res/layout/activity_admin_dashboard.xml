<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtAdminTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TECHFIX"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="5dp" />

    <TextView
        android:id="@+id/txtDashboardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Admin Dashboard"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="25dp" />

    <Button
        android:id="@+id/btnManageServices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Services"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnManageBranches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Branches"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnTechnicians"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Technicians"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnInventory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inventory"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnAppointments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Appointments"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnRepairStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Repair Status"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Customer Feedback"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnPayments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Payments &amp; Invoices"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout" />

</LinearLayout>