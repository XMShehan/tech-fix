<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F9FC"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1976D2"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TECHFIX"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book Appointment"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tell us about your device and choose a convenient time"
                android:textColor="#E3F2FD"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- CONTENT -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <!-- SERVICE DETAILS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="2dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service Details"
                    android:textColor="#263238"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repair Service"
                    android:textColor="#607D8B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edtProductService"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="#FFFFFF"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#263238"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textColor="#607D8B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edtCategory"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="#FFFFFF"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#263238"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimated Price"
                    android:textColor="#607D8B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edtPrice"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="#FFFFFF"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#1976D2"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

            </LinearLayout>

            <!-- DEVICE INFORMATION -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="2dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device Information"
                    android:textColor="#263238"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device Model"
                    android:textColor="#607D8B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edtDeviceModel"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="e.g. iPhone 13 / Dell Inspiron"
                    android:textColor="#263238"
                    android:textColorHint="#90A4AE"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Problem Description"
                    android:textColor="#607D8B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edtProblemDescription"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:hint="Describe the issue with your device"
                    android:textColor="#263238"
                    android:textColorHint="#90A4AE"
                    android:textSize="15sp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:padding="14dp"
                    android:background="#FFFFFF" />

            </LinearLayout>

            <!-- LOCATION -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="2dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Branch Selection"
                    android:textColor="#263238"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/radioGroupLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp">

                    <RadioButton
                        android:id="@+id/radioAutoDetect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Use nearest branch"
                        android:textColor="#37474F"
                        android:textSize="15sp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp" />

                    <RadioButton
                        android:id="@+id/radioManual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select branch manually"
                        android:textColor="#37474F"
                        android:textSize="15sp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp" />

                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Branch"
                    android:textColor="#607D8B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinnerBranch"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="#FFFFFF"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/txtTimeAvailability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Checking branch availability..."
                    android:textColor="#1976D2"
                    android:textSize="14sp"
                    android:paddingTop="4dp" />

            </LinearLayout>

            <!-- APPOINTMENT TIME -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="2dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appointment Schedule"
                    android:textColor="#263238"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/txtBusinessHours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Booking hours: 9:00 AM - 5:00 PM • 30-minute slots"
                    android:textColor="#607D8B"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appointment Date"
                    android:textColor="#607D8B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edtDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Select a date"
                    android:textColor="#263238"
                    android:textColorHint="#90A4AE"
                    android:textSize="15sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appointment Time"
                    android:textColor="#607D8B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinnerTime"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="#FFFFFF"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

            </LinearLayout>

            <!-- PHOTO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device Photo"
                    android:textColor="#263238"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <ImageView
                    android:id="@+id/imgProductPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:background="#ECEFF1"
                    android:scaleType="centerCrop"
                    android:contentDescription="Device photo"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnAddPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Add Device Photo"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_login_button"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <!-- ACTIONS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Cancel"
                    android:textColor="#455A64"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_dashboard_card"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnConfirm"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Confirm Appointment"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_login_button"
                    android:stateListAnimator="@null" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
