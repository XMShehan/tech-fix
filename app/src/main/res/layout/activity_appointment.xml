<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="25dp"
        android:paddingBottom="25dp">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create New Booking"
            android:textColor="#263238"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="5dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter your device and appointment details"
            android:textColor="#607D8B"
            android:textSize="14sp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- ===================================================== -->
        <!-- REPAIR SERVICE -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_dashboard_card"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Repair Service"
                android:textColor="#1976D2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="15dp" />

            <!-- SELECTED SERVICE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selected Service"
                android:textColor="#37474F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtProductService"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_input"
                android:textColor="#263238"
                android:textSize="15sp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:layout_marginBottom="14dp" />

            <!-- CATEGORY -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="#37474F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_input"
                android:textColor="#263238"
                android:textSize="15sp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:layout_marginBottom="14dp" />

            <!-- ESTIMATED PRICE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estimated Price"
                android:textColor="#37474F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtPrice"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_input"
                android:textColor="#1976D2"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Final price will be confirmed after the repair is completed."
                android:textColor="#607D8B"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- DEVICE DETAILS -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_dashboard_card"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Details"
                android:textColor="#1976D2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="15dp" />

            <!-- DEVICE MODEL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Model"
                android:textColor="#37474F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtDeviceModel"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Example: iPhone 13 / Dell Inspiron"
                android:textColor="#263238"
                android:textColorHint="#90A4AE"
                android:textSize="15sp"
                android:inputType="text"
                android:background="@drawable/bg_login_input"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:layout_marginBottom="15dp" />

            <!-- PROBLEM -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Describe the Problem"
                android:textColor="#37474F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtProblemDescription"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:hint="Explain what is wrong with your device..."
                android:textColor="#263238"
                android:textColorHint="#90A4AE"
                android:textSize="15sp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:background="@drawable/bg_login_input"
                android:padding="15dp" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- BRANCH -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_dashboard_card"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preferred Repair Branch"
                android:textColor="#1976D2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/radioGroupLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioAutoDetect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use Nearest Branch"
                    android:textColor="#263238"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/radioManual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Branch Manually"
                    android:textColor="#263238"
                    android:textSize="15sp" />

            </RadioGroup>

            <TextView
                android:id="@+id/txtAvailability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select a date to view available appointment slots."
                android:textColor="#607D8B"
                android:textSize="13sp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp" />

            <Spinner
                android:id="@+id/spinnerBranch"
                android:layout_width="match_parent"
                android:layout_height="52dp" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- DEVICE PHOTO -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_dashboard_card"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Photo"
                android:textColor="#1976D2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attach a photo of the device if helpful"
                android:textColor="#607D8B"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAddPhoto"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="📷  ADD PHOTO"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:background="@drawable/bg_register_button"
                android:layout_marginBottom="12dp" />

            <ImageView
                android:id="@+id/imgProductPhoto"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:visibility="gone"
                android:scaleType="centerCrop"
                android:contentDescription="Device photo"
                android:background="#E8EEF2" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- APPOINTMENT SCHEDULE -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_dashboard_card"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment Schedule"
                android:textColor="#1976D2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="15dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Business Hours"
                android:textColor="#37474F"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtBusinessHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Booking hours: 9:00 AM - 5:00 PM • 30-minute slots"
                android:textColor="#607D8B"
                android:textSize="13sp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="15dp" />

            <!-- DATE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment Date"
                android:textColor="#37474F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Select Date"
                android:textColor="#263238"
                android:textColorHint="#90A4AE"
                android:textSize="15sp"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:background="@drawable/bg_login_input"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:layout_marginBottom="15dp" />

            <!-- TIME -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment Time"
                android:textColor="#37474F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_input"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtTimeAvailability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select a date to view available slots."
                android:textColor="#607D8B"
                android:textSize="12sp"
                android:layout_marginBottom="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Appointments are available in 30-minute slots from 9:00 AM to 5:00 PM. Full slots cannot be selected."
                android:textColor="#607D8B"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- ACTION BUTTONS -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="CANCEL"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#607D8B"
                android:background="@drawable/bg_register_button"
                android:layout_marginEnd="7dp" />

            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="CONFIRM BOOKING"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_login_button"
                android:layout_marginStart="7dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
