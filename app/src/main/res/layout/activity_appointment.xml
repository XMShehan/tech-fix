<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="25dp"
        android:paddingBottom="30dp">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Appointment"
            android:textColor="#263238"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="5dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm your repair details"
            android:textColor="#607D8B"
            android:textSize="14sp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- ================================================= -->
        <!-- SELECTED PRODUCT -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_dashboard_card"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selected Product"
                android:textColor="#1976D2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="15dp" />

            <!-- PRODUCT -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product / Service"
                android:textColor="#37474F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtProductService"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_input"
                android:textColor="#263238"
                android:textColorHint="#90A4AE"
                android:textSize="15sp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:longClickable="false"
                android:textIsSelectable="false"
                android:layout_marginBottom="14dp" />

            <!-- CATEGORY -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="#37474F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_input"
                android:textColor="#263238"
                android:textColorHint="#90A4AE"
                android:textSize="15sp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:longClickable="false"
                android:textIsSelectable="false"
                android:layout_marginBottom="14dp" />

            <!-- PRICE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price"
                android:textColor="#37474F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtPrice"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_input"
                android:textColor="#1976D2"
                android:textColorHint="#90A4AE"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:longClickable="false"
                android:textIsSelectable="false" />

        </LinearLayout>

        <!-- ================================================= -->
        <!-- LOCATION -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_dashboard_card"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Repair Location"
                android:textColor="#1976D2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/radioGroupLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioAutoDetect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto Detect Nearest Branch"
                    android:textColor="#263238"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/radioManual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Manually Select Branch"
                    android:textColor="#263238"
                    android:textSize="15sp" />

            </RadioGroup>

            <TextView
                android:id="@+id/txtLocationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap Auto Detect to detect your location"
                android:textColor="#607D8B"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp" />

            <Spinner
                android:id="@+id/spinnerBranch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp" />

        </LinearLayout>

        <!-- ================================================= -->
        <!-- PHOTO -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_dashboard_card"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product Photo"
                android:textColor="#1976D2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attach a photo of your device if needed"
                android:textColor="#607D8B"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAddPhoto"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="📷  ADD PHOTO"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:background="@drawable/bg_register_button"
                android:layout_marginBottom="12dp" />

            <ImageView
                android:id="@+id/imgProductPhoto"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:visibility="visible"
                android:scaleType="centerCrop"
                android:contentDescription="Attached product photo"
                android:background="#E8EEF2" />

        </LinearLayout>

        <!-- ================================================= -->
        <!-- APPOINTMENT DATE -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_dashboard_card"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment Schedule"
                android:textColor="#1976D2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="15dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment Date"
                android:textColor="#37474F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Select Date"
                android:textColor="#263238"
                android:textColorHint="#90A4AE"
                android:textSize="15sp"
                android:focusable="false"
                android:clickable="true"
                android:background="@drawable/bg_login_input"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:layout_marginBottom="15dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment Time"
                android:textColor="#37474F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Select Time"
                android:textColor="#263238"
                android:textColorHint="#90A4AE"
                android:textSize="15sp"
                android:focusable="false"
                android:clickable="true"
                android:background="@drawable/bg_login_input"
                android:paddingStart="15dp"
                android:paddingEnd="15dp" />

        </LinearLayout>

        <!-- ================================================= -->
        <!-- ACTION BUTTONS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="CANCEL"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#607D8B"
                android:background="@drawable/bg_register_button"
                android:layout_marginEnd="7dp" />

            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="CONFIRM"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_login_button"
                android:layout_marginStart="7dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>