<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F9FC"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dashboard_header"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TECHFIX"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payment"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose your preferred payment method"
                android:textColor="#E3F2FD"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- CONTENT -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ================================================= -->
            <!-- PAYMENT DETAILS CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_dashboard_card"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Details"
                    android:textColor="#263238"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <!-- Appointment -->

                <TextView
                    android:id="@+id/txtAppointment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Appointment #"
                    android:textColor="#37474F"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:paddingBottom="8dp" />

                <!-- Service -->

                <TextView
                    android:id="@+id/txtService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Service:"
                    android:textColor="#607D8B"
                    android:textSize="14sp"
                    android:paddingBottom="10dp" />

                <!-- Amount -->

                <TextView
                    android:id="@+id/txtAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Amount:"
                    android:textColor="#1976D2"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:paddingTop="6dp" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- PAYMENT METHOD CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_dashboard_card"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Method"
                    android:textColor="#263238"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select how you would like to pay."
                    android:textColor="#607D8B"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <RadioGroup
                    android:id="@+id/paymentMethodGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioCash"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cash"
                        android:textColor="#37474F"
                        android:textSize="15sp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp" />

                    <RadioButton
                        android:id="@+id/radioBankTransfer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bank Transfer"
                        android:textColor="#37474F"
                        android:textSize="15sp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp" />

                    <RadioButton
                        android:id="@+id/radioCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Card Payment"
                        android:textColor="#37474F"
                        android:textSize="15sp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp" />

                </RadioGroup>

            </LinearLayout>

            <!-- ================================================= -->
            <!-- INFORMATION -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFF8E1"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Payment Information"
                    android:textColor="#795548"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cash and bank transfer payments remain pending until confirmed by an administrator."
                    android:textColor="#6D5D45"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- CONTINUE -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnConfirmPayment"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_login_button"
                android:text="Continue"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- ================================================= -->
            <!-- CANCEL -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_dashboard_card"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#607D8B"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>