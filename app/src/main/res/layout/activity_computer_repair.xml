<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Computer Repair"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/btnSoftwareInstallation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Software Installation"
        android:layout_marginBottom="15dp" />

    <Button
        android:id="@+id/btnHardwareRepair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hardware Repair"
        android:layout_marginBottom="15dp" />

    <Button
        android:id="@+id/btnWindowsInstallation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Windows Installation"
        android:layout_marginBottom="15dp" />

    <Button
        android:id="@+id/btnComputerUpgrade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Computer Upgrade" />
    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back"
        android:layout_marginTop="25dp" />

</LinearLayout>