<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TECHFIX"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Computer &amp; Mobile Repair"
            android:textSize="16sp"
            android:layout_gravity="center"
            android:layout_marginBottom="35dp" />

        <Button
            android:id="@+id/btnComputerRepair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Computer Repair"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnMobileRepair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mobile Repair"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnViewProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Products"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnMyAppointments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Appointments"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnRepairHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Repair History"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Feedback" />

    </LinearLayout>

</ScrollView>