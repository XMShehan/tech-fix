<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="25dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TECHFIX"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customer Dashboard"
        android:textSize="20sp"
        android:layout_marginBottom="35dp" />

    <Button
        android:id="@+id/btnComputerRepair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Computer Repair"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnMobileRepair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mobile Repair"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnMyAppointments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Appointments"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnRepairHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Repair History"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Feedback" />

</LinearLayout>