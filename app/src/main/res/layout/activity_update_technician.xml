<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F6FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update Technician"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/edtTechnicianName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Technician Name"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edtTechnicianPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Phone Number"
        android:inputType="phone"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edtTechnicianEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edtTechnicianSpecialization"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Specialization"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnUpdateTechnician"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update Technician"
        android:textSize="16sp" />

</LinearLayout>