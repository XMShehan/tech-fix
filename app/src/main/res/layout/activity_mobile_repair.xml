<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mobile Repair"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/btnDisplayReplacement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Display Replacement"
        android:layout_marginBottom="15dp" />

    <Button
        android:id="@+id/btnBatteryReplacement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Battery Replacement"
        android:layout_marginBottom="15dp" />

    <Button
        android:id="@+id/btnChargingPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Charging Port Repair"
        android:layout_marginBottom="15dp" />

    <Button
        android:id="@+id/btnCameraRepair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Camera Repair"
        android:layout_marginBottom="15dp" />

    <Button
        android:id="@+id/btnSpeakerRepair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Speaker / Microphone Repair" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back"
        android:layout_marginTop="25dp" />

</LinearLayout>