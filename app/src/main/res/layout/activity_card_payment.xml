<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F9FC"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dashboard_header"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TECHFIX"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Card Payment"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secure card payment"
                android:textColor="#E3F2FD"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- CONTENT -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ================================================= -->
            <!-- PAYMENT SUMMARY -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_dashboard_card"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Summary"
                    android:textColor="#263238"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/txtAppointment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Appointment #"
                    android:textColor="#37474F"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/txtService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Service:"
                    android:textColor="#607D8B"
                    android:textSize="14sp"
                    android:paddingBottom="10dp" />

                <TextView
                    android:id="@+id/txtAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Amount:"
                    android:textColor="#1976D2"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- CARD DETAILS -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_dashboard_card"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Card Details"
                    android:textColor="#263238"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Card Holder -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Card Holder Name"
                    android:textColor="#607D8B"
                    android:textSize="13sp"
                    android:layout_marginBottom="5dp" />

                <EditText
                    android:id="@+id/edtCardHolder"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="Enter card holder name"
                    android:inputType="textPersonName"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#263238"
                    android:textColorHint="#90A4AE"
                    android:textSize="14sp" />

                <!-- Card Number -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Card Number"
                    android:textColor="#607D8B"
                    android:textSize="13sp"
                    android:layout_marginBottom="5dp" />

                <EditText
                    android:id="@+id/edtCardNumber"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="Enter card number"
                    android:inputType="number"
                    android:maxLength="19"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#263238"
                    android:textColorHint="#90A4AE"
                    android:textSize="14sp" />

                <!-- Expiry -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expiry Date"
                    android:textColor="#607D8B"
                    android:textSize="13sp"
                    android:layout_marginBottom="5dp" />

                <EditText
                    android:id="@+id/edtExpiry"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="MM/YY"
                    android:inputType="text"
                    android:maxLength="5"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#263238"
                    android:textColorHint="#90A4AE"
                    android:textSize="14sp" />

                <!-- CVV -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CVV"
                    android:textColor="#607D8B"
                    android:textSize="13sp"
                    android:layout_marginBottom="5dp" />

                <EditText
                    android:id="@+id/edtCvv"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="Enter CVV"
                    android:inputType="numberPassword"
                    android:maxLength="3"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#263238"
                    android:textColorHint="#90A4AE"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- PAY NOW -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnPay"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_login_button"
                android:text="Pay Now"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- ================================================= -->
            <!-- CANCEL -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_dashboard_card"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#607D8B"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>